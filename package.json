{
  "name": "student-notes-sharing-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo wrapper for frontend and backend",
  "scripts": {
    "dev": "npx concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
